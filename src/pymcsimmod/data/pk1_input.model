#-------------------------------------------------------------------------------
# pk1.model
#
# A one-compartment classical pharmacokinetic model.
#
# Author: Dustin Kapraun, U.S. EPA, June 2019
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# STATE VARIABLES for the model (for which ODEs are provided).

States = {
    A_in,   # Amount being dosed in (mg).
    A0,     # Amount in exposure compartment (mg).
    A1,     # Amount in central compartment (mg).
    A2,     # Amount cleared (mg).
    AUC,    # Area under concentration curve (mg*h/L).
};

# End of STATE VARIABLES.
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# OUTPUT VARIABLES for the model (which can be obtained at any point in time
# as analytic functions of state variables, input variables, and parameters).

Outputs = {
    C,      # Concentration in central compartment (mg/L).
    Atot,   # Total amount in system (mg).
    C_mg,   # Concentration in mg/L
    C_umol, # Concentration in umol/L
    M,      # Body mass (kg).
};

# End of OUTPUT VARIABLES.
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# INPUT VARIABLES for the model (which are independent of other variables, and
# which may vary in time).

Inputs = {OralExp, IVExp, M_in};

# End of INPUT VARIABLES.
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# PARAMETERS for the model (which are independent of time).

# Experimental parameters.
Vdc = 0.1;            # Volume of distribution (L).
k01 = 1;            # Absorption rate (h^{-1}).
k12 = 0.5;          # Clearance rate (h^{-1}).
MW = 150;           # Molecular weight (g/mol).

# Initial conditions for single dose
A0_init = 0;      # Initial amount in exposure compartment (mg).
A1_init = 0;        # Initial amount in central compartment (mg).
A2_init = 0;        # Initial amount cleared (mg).
AUC_init = 0;       # Initial area under the concentration curve (mg*h/L).

# Dosing parameters for repeat dose
OralDose = 0;       # mg dose to expsoure compartment
OralDur = 0.01;     # Duration of oral dosing (h)
IVDose = 0;         # mg dose to central compartment
IVDur = 0.01;       # Duration of IV dosing (h)

# End of PARAMETERS.
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# MODEL INITIALIZATION section.

Initialize {
    # Assign an initial value for each state variable.
    A_in = 0;
    A0 = A0_init;
    A1 = A1_init;
    A2 = A2_init;
    AUC = AUC_init;
}

# End of MODEL INITIALIZATION.
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# DYNAMICS section.

Dynamics {
    # Output variables.
    M = M_in;  # Body mass (kg).
    Vd = Vdc * M;  # Volume of distribution (L).
    C = A1 / Vd;          # Concentration in central compartment (mg/L).
    ODose = OralDose / OralDur; # Rate of dosing
    oral_rate = OralExp*ODose;
    

    # Time rate of change (ODE) for each state variable.
    dt(A_in) = oral_rate;
    dt(A0) = oral_rate - k01 * A0;
    dt(A1) = IVExp*ODose + k01 * A0 - k12 * A1;
    dt(A2) = k12 * A1;
    dt(AUC) = C;
}

# End of DYNAMICS.
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# CALCOUTPUTS section.

CalcOutputs {
    C_mg = C; # mg/L concentration
    C_umol = C / (MW * 1000); # umol/L concentration

    Atot = A0 + A1 + A2;  # Total mass in system (mg).

}

End.